# ============================================================
# PNGUOT GEMS — Root .htaccess
# Apache shared hosting
# ============================================================

Options -Indexes

# ── PHP settings (shared hosting — ini_set in .htaccess) ─────
php_value upload_max_filesize 12M
php_value post_max_size 13M
php_value max_execution_time 60
php_value memory_limit 128M

# ── Protect sensitive directories from direct access ─────────
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to config/ directory
    RewriteRule ^config/ - [F,L]

    # Block direct access to database/ directory
    RewriteRule ^database/ - [F,L]
</IfModule>

# ── Protect sensitive files ───────────────────────────────────
<FilesMatch "\.(sql|log|md|json|lock|env|sh|bak)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Security headers ─────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Cache static assets ───────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css             "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg           "access plus 30 days"
    ExpiresByType image/png            "access plus 30 days"
    ExpiresByType image/gif            "access plus 30 days"
</IfModule>

# ── Gzip compression ─────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
